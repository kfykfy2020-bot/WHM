function contabo_ClientArea(array $params)
{
    $sid = (int) $params['serviceid'];
    $uid = (int) ($params['userid'] ?? 0);
    $showtech = ($uid === 1); // white-label: only owner (#1) sees server/Contabo details; clients see a managed-service notice
    $ip = '';
    $id = '';
    if ($showtech) {
        $ip = (string) Capsule::table('tblhosting')->where('id', $sid)->value('dedicatedip');
        $id = contabo_instanceId($sid);
        if ($id !== '' && $ip === '') {
            try {
                $token = contabo_apiToken(contabo_getCreds($params));
                $resp = contabo_apiRequest($token, 'GET', '/v1/compute/instances/' . $id);
                $ip = contabo_extractIp($resp['data'][0] ?? []);
                if ($ip !== '') {
                    Capsule::table('tblhosting')->where('id', $sid)->update(['dedicatedip' => $ip]);
                }
            } catch (\Throwable $e) {
            }
        }
    }
    return [
        'templatefile' => 'clientarea',
        'vars' => ['ip' => $ip, 'instanceid' => $id, 'showtech' => $showtech],
    ];
}

function contabo_AdminServicesTabFields(array $params)
{
    try {
        $id = contabo_instanceId((int) $params['serviceid']);
        if ($id === '') {
            return ['حالة الخادم' => 'لا يوجد instance مرتبط بعد'];
        }
        $token = contabo_apiToken(contabo_getCreds($params));
        $resp = contabo_apiRequest($token, 'GET', '/v1/compute/instances/' . $id);
        $inst = $resp['data'][0] ?? [];
        return [
            'Instance ID' => htmlspecialchars($id),
            'الحالة' => htmlspecialchars((string) ($inst['status'] ?? '?')),
            'IP' => htmlspecialchars(contabo_extractIp($inst)),
            'المنتج' => htmlspecialchars((string) ($inst['productId'] ?? '')),
        ];
    } catch (\Throwable $e) {
        return ['خطأ' => htmlspecialchars($e->getMessage())];
    }
}
