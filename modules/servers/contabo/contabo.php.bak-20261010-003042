function contabo_sync(array $params)
{
    try {
        $id = contabo_instanceId((int) $params['serviceid']);
        if ($id === '') {
            return 'No instance id stored for this service.';
        }
        $token = contabo_apiToken(contabo_getCreds($params));
        $resp = contabo_apiRequest($token, 'GET', '/v1/compute/instances/' . $id);
        $inst = $resp['data'][0] ?? [];
        $ip = contabo_extractIp($inst);
        if ($ip !== '') {
            Capsule::table('tblhosting')->where('id', $params['serviceid'])->update(['dedicatedip' => $ip]);
        }
        logModuleCall('contabo', 'sync', $id, $resp);
        return 'success';
    } catch (\Throwable $e) {
        return $e->getMessage();
    }
}

function contabo_catalog(array $params)
{
    try {
        $token = contabo_apiToken(contabo_getCreds($params));
        $products = contabo_apiRequest($token, 'GET', '/v1/compute/products?size=100');
        logModuleCall('contabo', 'catalog-products', 'GET /v1/compute/products', $products);
        try {
            $images = contabo_apiRequest($token, 'GET', '/v1/compute/images?size=100');
            logModuleCall('contabo', 'catalog-images', 'GET /v1/compute/images', $images);
        } catch (\Throwable $ie) {
            logModuleCall('contabo', 'catalog-images', 'GET /v1/compute/images', $ie->getMessage());
        }
        return 'success — راجع Utilities ▸ Logs ▸ Module Log';
    } catch (\Throwable $e) {
        return $e->getMessage();
    }
}

