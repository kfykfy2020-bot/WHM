<?php
if (!defined('WHMCS')) { die('Access Denied'); }
use WHMCS\Database\Capsule;
// Hide client-side control buttons + "Change Password" on MANAGED-product service pages only.
add_hook('ClientAreaFooterOutput', 1, function ($vars) {
    if ((($_GET['action'] ?? '') !== 'productdetails')) { return ''; }
    $sid = (int) ($_GET['id'] ?? 0);
    if (!$sid) { return ''; }
    $pid = (int) Capsule::table('tblhosting')->where('id', $sid)->value('packageid');
    if (!in_array($pid, [70], true)) { return ''; }
    return <<<'HTML'
<script>
(function(){function h(){document.querySelectorAll('a,button').forEach(function(e){var t=(e.textContent||'').trim();var a=((e.getAttribute('href')||'')+' '+(e.getAttribute('onclick')||''));if(/changepassword/i.test(a)||t==='تغيير كلمة المرور'||/a=boot|a=shutdown|a=reboot/i.test(a)||t==='تشغيل'||t==='إيقاف'||t==='إعادة تشغيل'){var li=e.closest('li');(li||e).style.display='none';}});}
if(document.readyState!=='loading')h();else document.addEventListener('DOMContentLoaded',h);})();
</script>
HTML;
});